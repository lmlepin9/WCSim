# Interactive event-display setup with cleaner defaults for repeated viewing.
# Usage:
#   1. Start WCSim interactively: ./WCSim
#   2. At the Geant4 prompt: /control/execute macros/visEventDisplay.mac
#   3. Fire events with: /run/beamOn 1

/run/verbose 0
/tracking/verbose 0
/hits/verbose 0
/process/verbose 0

# Use a simple local source so the display works without external beam files.
/mygen/generator gun
/gun/particle mu-
/gun/energy 700 MeV
/gun/direction 1 0 0
/gun/position 0 0 0

# Save and draw trajectories for interactive inspection.
/tracking/storeTrajectory 1

/control/execute macros/visOGLSX.mac

# Build a stable event-display scene.
/vis/drawVolume
/vis/scene/add/trajectories smooth
/vis/modeling/trajectories/create/drawByParticleID
/vis/modeling/trajectories/drawByParticleID-0/set e- cyan
/vis/modeling/trajectories/drawByParticleID-0/set e+ yellow
/vis/modeling/trajectories/drawByParticleID-0/set mu- green
/vis/modeling/trajectories/drawByParticleID-0/set mu+ magenta
/vis/modeling/trajectories/drawByParticleID-0/set gamma red
/vis/modeling/trajectories/drawByParticleID-0/set opticalphoton blue

# Keep events visible until you choose to refresh.
/vis/scene/endOfEventAction accumulate

# Helpful defaults for interactive exploration.
/vis/viewer/set/autoRefresh true
/vis/viewer/set/style surface
/vis/viewer/set/auxiliaryEdge true
/vis/viewer/set/hiddenEdge false
/vis/viewer/zoom 1.3
/vis/viewer/flush

# Handy follow-up commands:
#   /run/beamOn 1
#   /vis/scene/endOfEventAction refresh
#   /vis/scene/endOfEventAction accumulate
#   /vis/viewer/set/viewpointThetaPhi 90 0
#   /vis/viewer/flush
