# Interactive event display using the Qt OpenGL backend when available.
# This is usually the best choice if you want a draggable/zoomable window.
#
# Usage:
#   1. Start WCSim interactively: ./WCSim
#   2. At the Geant4 prompt: /control/execute macros/visQtEventDisplay.mac
#   3. Fire events with: /run/beamOn 1

/run/verbose 0
/tracking/verbose 0
/hits/verbose 0
/process/verbose 0

/mygen/generator gun
/gun/particle mu-
/gun/energy 700 MeV
/gun/direction 1 0 0
/gun/position 0 0 0

/tracking/storeTrajectory 1

/vis/open OGLSQt 1200x900-0+0
/vis/drawVolume
/vis/viewer/set/background white 0
/vis/viewer/set/style surface
/vis/viewer/set/auxiliaryEdge true
/vis/viewer/set/hiddenEdge false
/vis/viewer/set/upVector 0 1 0
/vis/viewer/set/viewpointThetaPhi -95 -15
/vis/viewer/zoom 1.3

/vis/scene/add/trajectories smooth
/vis/modeling/trajectories/create/drawByParticleID
/vis/modeling/trajectories/drawByParticleID-0/set e- cyan
/vis/modeling/trajectories/drawByParticleID-0/set e+ yellow
/vis/modeling/trajectories/drawByParticleID-0/set mu- green
/vis/modeling/trajectories/drawByParticleID-0/set mu+ magenta
/vis/modeling/trajectories/drawByParticleID-0/set gamma red
/vis/modeling/trajectories/drawByParticleID-0/set opticalphoton blue
/vis/scene/endOfEventAction accumulate
/vis/viewer/set/autoRefresh true
/vis/viewer/rebuild
/vis/viewer/flush
